# Model (OpenAI-compatible). Key goes only in .env, never in git.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-flash
# Postgres from docker-compose.yml
DATABASE_URL=postgresql://nota:nota@localhost:55432/nota
# Quota (defaults shown): Free 10 recordings/day, 300 speech minutes/month, 30 asks/month;
# Pro fair use 4h / 16h / 20h of speech per rolling 24h / 3 days / 7 days
# QUOTA_FREE_RECORDINGS_PER_DAY=10
# QUOTA_FREE_MINUTES_PER_MONTH=300
# QUOTA_FREE_ASKS_PER_MONTH=30
# QUOTA_PRO_MINUTES_PER_24H=240
# QUOTA_PRO_MINUTES_PER_3D=960
# QUOTA_PRO_MINUTES_PER_7D=1200
